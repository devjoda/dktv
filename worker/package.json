  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
