{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dktv",
	// Not a secret: it names the account, and the API token gives the access
	"account_id": "144b7e09a21af23b5f55e266e95a8c01",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	// The browser's files, copied from ../drtvrss/static by `npm run build`, and served without the Worker
	"assets": {
		"directory": "public"
	},
	"build": {
		"command": "npm run build"
	},
	"d1_databases": [
		{
			// Viewers' favourites and progress, for those who sync their devices
			"binding": "SYNC",
			"database_name": "dktv-sync",
			"database_id": "91fd29bf-7587-40c3-ba2d-1162d30a482d",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"SERVICE_NAME": "Flimmerkassen",
		// Where the code that runs here can be got
		"SOURCE_URL": "https://github.com/devjoda/dktv",
		// Shows for the front page, like "rejseholdet_503605:matador_540736"
		"RECOMMENDED_SHOWS": "",
		// For notifications about new episodes; the private key is the secret VAPID_PRIVATE_KEY.
		// Browsers subscribe with this one, so changing it means turning notifications on again.
		"VAPID_PUBLIC_KEY": "BNfgOxwFCdEoFrhqG8t5AhzWaqzWa29w3jCcisROVirBcvE7DJZ6N-yhqrd_rI_--vQPbpoeU4h42A_4aK5rEK4"
	},
	// "Se sammen": a room for each group watching together
	"durable_objects": {
		"bindings": [
			{"name": "ROOMS", "class_name": "Room"}
		]
	},
	"migrations": [
		// SQLite-backed, which the free plan has
		{"tag": "v1", "new_sqlite_classes": ["Room"]}
	],
	// Checks the followed series for new episodes, and sends notifications, every minute; and every minute, in a run of its
	// own, goes on with the catalogue of DR's titles, as two schedules, of the even minutes and the odd (CRONS in
	// src/catalogue.ts), since Cloudflare runs each schedule once a minute at most
	"triggers": {
		"crons": ["* * * * *", "*/2 * * * *", "1-59/2 * * * *"]
	},
	// Which deploy is running, so pages kept from before an update aren't served after it
	"version_metadata": {
		"binding": "VERSION"
	},
	"observability": {
		"enabled": true
	}
}
